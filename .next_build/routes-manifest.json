      "regex": "^/favicon\\.ico(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/favicon\\.ico(?:/)?$"
    },
    {
      "page": "/investorsDashboard",
      "regex": "^/investorsDashboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/investorsDashboard(?:/)?$"
    },
    {
      "page": "/login",
      "regex": "^/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/login(?:/)?$"
    },
    {
      "page": "/propertiesDashboard",
      "regex": "^/propertiesDashboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/propertiesDashboard(?:/)?$"
    },
    {
      "page": "/register",
      "regex": "^/register(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/register(?:/)?$"
    },
    {
      "page": "/user",
      "regex": "^/user(?:/)?$",
